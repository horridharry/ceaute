# Ceaute environment variables. Copy to .env.local and fill in.
# Every variable here is required — nothing in the code has a fallback.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable key>"
# Server-only. Never expose to the browser, a Client Component or a
# NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# --- Stripe -----------------------------------------------------------------
# Which Stripe mode this deployment runs in: "test" or "live". Defaults to
# "test" when unset. Ceaute refuses to start a Stripe call when this and the
# secret key below disagree, so going live means changing BOTH, together.
STRIPE_MODE="test"

# Must match STRIPE_MODE: sk_test_… / rk_test_… for test, sk_live_… / rk_live_…
# for live.
STRIPE_SECRET_KEY="sk_test_..."

# Signing secrets for the two webhook endpoints. These are per destination AND
# per mode — a Live destination, Test Workbench destination and Stripe CLI
# listener each have different secrets. Preview uses the secret for the Test
# destination that targets its stable Vercel branch URL; Production uses the
# secret for the Live destination at ceaute.com. See
# docs/stripe-preview-testing.md and docs/stripe-live-activation.md.
#   POST /api/stripe/payments
STRIPE_PAYMENT_WEBHOOK_SECRET="whsec_..."
#   POST /api/stripe/connect
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY="re_..."
# Must be a verified sender on the Resend domain.
CEAUTE_EMAIL_FROM="Ceaute <bookings@ceaute.com>"

# --- Application ------------------------------------------------------------
# Canonical origin. Used for links in booking emails and for Stripe Checkout
# success/cancel URLs. Resolved by src/lib/app/origin.js:
#
#   Local / Development   CEAUTE_APP_URL, normally http://localhost:3000
#   Vercel Preview        automatically derived from VERCEL_URL as
#                         https://$VERCEL_URL, so each preview deployment links
#                         back to itself. CEAUTE_APP_URL is ignored there, but
#                         still set it in the Preview environment — the value
#                         is the fallback if Vercel ever stops providing
#                         VERCEL_URL, and email delivery treats a missing
#                         origin as "not configured".
#   Production            CEAUTE_APP_URL, pinned to https://ceaute.com.
#                         VERCEL_URL is deliberately NOT used, so Stripe return
#                         URLs and email links always point at the canonical
#                         domain.
#
# VERCEL_ENV and VERCEL_URL are injected by Vercel. Do not set them by hand.
CEAUTE_APP_URL="https://ceaute.com"

# Bearer token the scheduled routes require. Must match the `ceaute_cron_secret`
# secret in Supabase Vault, which is what pg_cron sends.
CRON_SECRET="<random string>"

# --- Operator ---------------------------------------------------------------
# Where payment-dispute alerts are sent. Falls back to the published contact
# address in src/lib/legal/identity.js if unset, so an alert is never silently
# dropped.
CEAUTE_OPERATOR_EMAIL="ops@ceaute.com"

# Bearer token for GET /api/operator/disputes. Deliberately NOT the same as
# CRON_SECRET: that one lives in Supabase Vault and is handed to a machine,
# this one is read by a person.
CEAUTE_OPERATOR_SECRET="<random string>"
